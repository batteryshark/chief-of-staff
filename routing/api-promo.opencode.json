{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "anthropic-promo": {
      "name": "Anthropic API promotional (manual use NOT budget protected)",
      "canonical": "anthropic",
      "package": "@opencode/ai/providers/anthropic",
      "env": [],
      "settings": {
        "apiKey": "{file:~/.chief-of-staff/secrets/anthropic-api.key}",
        "transport": "http"
      },
      "body": {"max_tokens": 8192},
      "models": {
        "claude-fable-5-1": {
          "modelID": "claude-fable-5-1",
          "body": {"max_tokens": 32768},
          "variants": [{"id": "high", "body": {"output_config": {"effort": "high"}}}]
        },
        "claude-opus-5-5": {"modelID": "claude-opus-5-5"},
        "claude-haiku-5-5": {
          "modelID": "claude-haiku-5-5",
          "body": {"max_tokens": 32}
        }
      }
    }
  },
  "agents": {
    "api-promo-review": {
      "description": "Fresh no-tools API review; Runway admission required; no autonomous jobs",
      "mode": "subagent",
      "system": "Review only the supplied text. Return one concise independent judgment. Do not request tools or continuation.",
      "permissions": [{"action": "*", "resource": "*", "effect": "deny"}]
    }
  }
}
